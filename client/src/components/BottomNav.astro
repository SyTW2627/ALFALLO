---
// Navegación principal: barra inferior en móvil y barra lateral en escritorio.
const path = Astro.url.pathname;

const links = [
  {
    href: "/",
    label: "Inicio",
    icon: '<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/>',
  },
  {
    href: "/entrenamiento",
    label: "Entrenar",
    icon: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2"/><path d="M10 2h4"/>',
  },
  {
    href: "/estadisticas",
    label: "Estadísticas",
    icon: '<path d="M3 3v18h18"/><path d="M8 17v-5M13 17V8M18 17v-9"/>',
  },
  {
    href: "/rutinas",
    label: "Rutinas",
    icon: '<path d="M6.5 6.5v11M17.5 6.5v11M3.5 9v6M20.5 9v6M6.5 12h11"/>',
  },
  {
    // La propia página comprueba la sesión: sin sesión redirige a /registro.
    href: "/perfil-usuario",
    label: "Perfil",
    icon: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  },
  {
    href: "/progreso",
    label: "Logros",
    icon: '<path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4ZM7 6H4a3 3 0 0 0 3 4M17 6h3a3 3 0 0 1-3 4"/>',
  },
];

const isActive = (href: string) =>
  href === "/"
    ? path === "/"
    : path.startsWith(href) || (href === "/entrenamiento" && path.startsWith("/historial"));
---

<nav
  aria-label="Navegación principal"
  class="fixed inset-x-0 bottom-0 z-50 border-t border-borde/80 bg-superficie/85 pb-[env(safe-area-inset-bottom)] backdrop-blur-xl
         md:inset-y-0 md:right-auto md:flex md:w-20 md:flex-col md:border-r md:border-t-0 md:bg-superficie/60 md:px-3 md:py-6 lg:w-64 lg:px-4"
>
  <!-- Logo: el disco en tableta (barra estrecha) y el logo completo en escritorio -->
  <a href="/" class="mb-8 hidden justify-center md:flex lg:justify-start lg:px-3" aria-label="AlFallo, ir al inicio">
    <img src="/images/disco.webp" alt="AlFallo" width="40" height="40" class="h-10 w-10 lg:hidden" />
    <img src="/images/logo-claro.webp" alt="AlFallo" width="144" height="48" class="solo-claro hidden h-10 w-auto lg:block" />
    <img src="/images/logo-oscuro.webp" alt="AlFallo" width="144" height="48" class="solo-oscuro hidden h-10 w-auto lg:block" />
  </a>

  <p class="mb-2 hidden px-3 text-[11px] font-semibold uppercase tracking-[0.14em] text-suave lg:block">Tu espacio</p>

  <!-- Enlaces -->
  <ul class="mx-auto grid max-w-lg grid-cols-6 px-1 md:mx-0 md:flex md:max-w-none md:flex-col md:gap-1 md:px-0">
    {
      links.map((l) => {
        const activo = isActive(l.href);
        return (
          <li>
            <a
              href={l.href}
              aria-current={activo ? "page" : undefined}
              title={l.label}
              class:list={[
                "group relative flex h-16 flex-col items-center justify-center gap-1 rounded-xl text-[10.5px] font-semibold tracking-tight transition-colors",
                "md:h-12 md:flex-row md:justify-center md:gap-3 md:text-sm md:font-medium md:tracking-normal lg:h-11 lg:justify-start lg:px-3",
                activo ? "text-primario md:bg-primario/10" : "text-suave hover:text-texto md:hover:bg-elevada",
              ]}
            >
              {/* En móvil, una pastilla detrás del icono marca la sección activa */}
              <span
                class:list={[
                  "grid h-8 w-12 place-items-center rounded-full transition-colors md:h-auto md:w-auto",
                  activo ? "bg-primario/12 md:bg-transparent" : "group-hover:bg-elevada md:group-hover:bg-transparent",
                ]}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="21"
                  height="21"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width={activo ? "2.3" : "2"}
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={l.icon}
                />
              </span>
              <span class="max-w-full truncate px-0.5 md:sr-only lg:not-sr-only lg:px-0">{l.label}</span>
              {activo && <span aria-hidden="true" class="absolute inset-y-2.5 -left-3 hidden w-1 rounded-r-full bg-primario md:block lg:-left-4" />}
            </a>
          </li>
        );
      })
    }
  </ul>

  <!-- Frase motivacional (solo escritorio) -->
  <div class="mt-auto hidden overflow-hidden rounded-2xl border border-borde bg-elevada/60 p-4 lg:block">
    <div class="flex items-center gap-3">
      <img src="/images/disco.webp" alt="" width="36" height="36" class="h-9 w-9 shrink-0" />
      <p class="text-sm font-semibold leading-snug">
        Una repetición más.<br />Un paso más fuerte.
      </p>
    </div>
    <p class="mt-2 text-xs text-suave">Hazlo por ti.</p>
  </div>
</nav>
