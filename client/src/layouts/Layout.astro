---
import "../styles/global.css";
import BottomNav from "../components/BottomNav.astro";
import CampanaNotificaciones from "../components/CampanaNotificaciones.jsx";
import SelectorTema from "../components/SelectorTema.astro";
import BackLink from "../components/BackLink.astro";

interface Props {
  title?: string;
  description?: string;
  showNav?: boolean;
  /** Sin navegación: muestra un botón "volver" arriba a la izquierda que lleva aquí. */
  volver?: string;
}

const {
  title = "AlFallo",
  description = "Planifica, registra y supera tus entrenamientos de fuerza.",
  showNav = true,
  volver,
} = Astro.props;
---

<!doctype html>
<html lang="es" data-tema="oscuro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09090b" />
    <!-- Tema: antes de pintar nada, para que no haya parpadeo.
         "tema" guardado = elección del usuario; si no hay, se sigue el sistema. -->
    <script is:inline>
      (function () {
        var raiz = document.documentElement;
        var sistema = window.matchMedia("(prefers-color-scheme: light)");
        function guardado() {
          try {
            var t = localStorage.getItem("tema");
            return t === "claro" || t === "oscuro" ? t : null;
          } catch (e) {
            return null;
          }
        }
        function aplicar() {
          var t = guardado() || (sistema.matches ? "claro" : "oscuro");
          raiz.dataset.tema = t;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", t === "claro" ? "#f6f5f2" : "#09090b");
        }
        aplicar();
        sistema.addEventListener && sistema.addEventListener("change", function () {
          if (!guardado()) aplicar();
        });
      })();
    </script>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- App instalable (PWA) -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="AlFallo" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class:list={["min-h-dvh", showNav && "md:pl-20 lg:pl-64"]}>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:rounded-lg focus:bg-primario focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-tinta"
    >
      Saltar al contenido
    </a>

    <!-- Avisos de la PWA: los muestra/oculta src/lib/pwa.js -->
    <p
      id="aviso-red"
      role="status"
      hidden
      class="fixed inset-x-4 top-3 z-[60] mx-auto w-fit max-w-[calc(100%-2rem)] rounded-full border border-primario/40 bg-elevada px-4 py-2 text-center text-xs font-semibold text-primario shadow-lg shadow-sombra/30"
    >
    </p>
    <div
      id="aviso-instalar"
      hidden
      class="fixed inset-x-4 bottom-24 z-[60] mx-auto max-w-md rounded-2xl border border-borde bg-superficie p-4 shadow-2xl shadow-sombra/40 md:bottom-6 md:left-28 lg:left-72"
    >
      <div class="flex items-start gap-3">
        <img src="/images/disco.webp" alt="" width="40" height="40" class="h-10 w-10 shrink-0" />
        <div>
          <p class="text-sm font-bold">Instala AlFallo</p>
          <p class="mt-0.5 text-xs text-suave">Ábrela como una app y entrena aunque el gimnasio no tenga cobertura.</p>
        </div>
      </div>
      <div class="mt-3 flex gap-2">
        <button
          type="button"
          data-instalar
          class="h-10 flex-1 rounded-xl bg-primario text-sm font-bold text-tinta transition hover:brightness-110"
        >
          Instalar
        </button>
        <button
          type="button"
          data-cerrar
          class="h-10 rounded-xl px-4 text-sm font-semibold text-suave transition hover:text-texto"
        >
          Ahora no
        </button>
      </div>
    </div>

    {showNav && <BottomNav />}

    <!-- Barra superior: logo en móvil, selector de tema y campanita -->
    <header
      class:list={[
        "sticky top-0 z-40 pt-[env(safe-area-inset-top)] md:relative",
        showNav && "border-b border-borde/70 bg-fondo/80 backdrop-blur-xl md:border-transparent md:bg-transparent md:backdrop-blur-none",
      ]}
    >
      <div class="mx-auto flex h-16 w-full max-w-[1600px] items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
        {
          showNav ? (
            <a href="/" class="flex items-center md:invisible" aria-label="AlFallo, ir al inicio">
              <img src="/images/logo-claro.webp" alt="AlFallo" width="96" height="32" class="solo-claro h-7 w-auto" />
              <img src="/images/logo-oscuro.webp" alt="AlFallo" width="96" height="32" class="solo-oscuro h-7 w-auto" />
            </a>
          ) : volver ? (
            <BackLink href={volver} />
          ) : (
            <span />
          )
        }
        <div class="flex items-center gap-2">
          <SelectorTema />
          {showNav && <CampanaNotificaciones client:only="react" />}
        </div>
      </div>
    </header>

    <main
      id="contenido"
      class:list={[
        "mx-auto w-full max-w-[1600px] px-4 sm:px-6 lg:px-8",
        showNav ? "pb-[calc(7rem+env(safe-area-inset-bottom))] pt-4 md:pb-16 md:pt-2" : "pb-12 pt-2",
      ]}
    >
      <slot />
    </main>

    <script>
      import { iniciarPwa } from "../lib/pwa.js";
      iniciarPwa();
    </script>
  </body>
</html>
