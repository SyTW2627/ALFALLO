---
import "../styles/global.css";
import BottomNav from "../components/BottomNav.astro";
import CampanaNotificaciones from "../components/CampanaNotificaciones.jsx";

interface Props {
  title?: string;
  description?: string;
  showNav?: boolean;
}

const {
  title = "AlFallo",
  description = "Planifica, registra y supera tus entrenamientos de fuerza.",
  showNav = true,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0d" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- App instalable (PWA) -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="AlFallo" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class:list={["min-h-screen", showNav && "pb-24 md:pb-0 md:pl-56"]}>
    <!-- Avisos de la PWA: los muestra/oculta src/lib/pwa.js -->
    <p
      id="aviso-red"
      role="status"
      hidden
      class="fixed inset-x-4 top-3 z-50 mx-auto w-fit max-w-[calc(100%-2rem)] rounded-full border border-primario/40 bg-elevada px-4 py-2 text-center text-xs font-semibold text-primario shadow-lg shadow-black/40"
    >
    </p>
    <div
      id="aviso-instalar"
      hidden
      class="fixed inset-x-4 bottom-24 z-50 mx-auto max-w-md rounded-2xl border border-borde bg-elevada p-4 shadow-2xl shadow-black/60 md:bottom-6 md:left-60"
    >
      <p class="text-sm font-bold">Instala AlFallo</p>
      <p class="mt-1 text-xs text-suave">Ábrela como una app y entrena aunque el gimnasio no tenga cobertura.</p>
      <div class="mt-3 flex gap-2">
        <button
          type="button"
          data-instalar
          class="h-10 flex-1 rounded-lg bg-primario text-sm font-bold text-fondo transition hover:brightness-110"
        >
          Instalar
        </button>
        <button
          type="button"
          data-cerrar
          class="h-10 rounded-lg px-4 text-sm font-semibold text-suave transition hover:text-white"
        >
          Ahora no
        </button>
      </div>
    </div>

    <!-- Campanita de notificaciones (solo se ve con la sesión iniciada) -->
    {
      showNav && (
        <div class="flex h-10 justify-end px-4 pt-4 md:px-8 md:pt-6" style="box-sizing: content-box">
          <CampanaNotificaciones client:only="react" />
        </div>
      )
    }
    <main class:list={["mx-auto px-4 md:px-8", showNav ? "pb-6 pt-2 md:pb-10 md:pt-3" : "py-6 md:py-10"]}>
      <slot />
    </main>
    {showNav && <BottomNav />}

    <script>
      import { iniciarPwa } from "../lib/pwa.js";
      iniciarPwa();
    </script>
  </body>
</html>