---
import Layout from "../layouts/Layout.astro";
import CabeceraInicio from "../components/CabeceraInicio.jsx";
import FeedComunidad from "../components/feed/FeedComunidad.jsx";
---

<Layout title="Inicio · AlFallo">
  <!-- Sin sesión se ve solo la portada de CabeceraInicio; esto evita que aparezca el resto un instante -->
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem("token");
        var exp = t ? JSON.parse(atob(t.split(".")[1].replace(/-/g, "+").replace(/_/g, "/"))).exp : 0;
        if (!exp || exp * 1000 < Date.now()) document.documentElement.classList.add("sin-sesion");
      } catch (e) {
        document.documentElement.classList.add("sin-sesion");
      }
    })();
  </script>
  <style is:global>
    .sin-sesion [data-solo-sesion] {
      display: none;
    }
  </style>

  <CabeceraInicio client:load />

  <div data-solo-sesion class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px] xl:grid-cols-[minmax(0,1fr)_360px]">
    <!-- Comunidad -->
    <section aria-labelledby="comunidad" class="min-w-0">
      <div class="mb-4 flex items-end justify-between gap-3">
        <div>
          <h2 id="comunidad" class="text-xl font-bold">Comunidad</h2>
          <p class="mt-0.5 text-sm text-suave">Entrenamientos de la gente que sigues.</p>
        </div>
        <a
          href="/descubrir"
          class="inline-flex h-9 shrink-0 items-center gap-1.5 rounded-full border border-borde bg-superficie px-3.5 text-xs font-semibold transition hover:border-primario/40 hover:text-primario"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
          </svg>
          Descubrir gente
        </a>
      </div>

      <FeedComunidad soloSeguidos client:only="react" />
    </section>

    <!-- Columna derecha -->
    <aside class="space-y-4 lg:sticky lg:top-6 lg:self-start" aria-labelledby="tu-entrenamiento">
      <h2 id="tu-entrenamiento" class="text-xl font-bold">Tu entrenamiento</h2>

      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-primario to-orange-700 p-6 text-tinta shadow-xl shadow-primario/20">
        <img
          src="/images/disco.webp"
          alt=""
          aria-hidden="true"
          width="160"
          height="160"
          class="pointer-events-none absolute -bottom-10 -right-10 h-40 w-40 opacity-25 mix-blend-multiply"
        />
        <p class="text-[11px] font-bold uppercase tracking-[0.14em] opacity-80">Próximo entrenamiento</p>
        <p class="mt-2 font-[family-name:var(--font-display)] text-4xl font-extrabold tracking-tight">Torso</p>
        <p class="mt-1 text-sm font-medium opacity-90">Gana fuerza. Supera tus límites.</p>
        <p class="mt-3 text-xs font-semibold opacity-80">6 ejercicios · 55–65 min</p>
        <a
          href="/entrenamiento"
          class="relative mt-5 flex h-12 items-center justify-center gap-2 rounded-xl bg-tinta text-sm font-bold text-primario transition hover:opacity-90"
        >
          Empezar entrenamiento
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>

      <div class="rounded-3xl border border-borde bg-superficie p-6">
        <div class="flex items-center gap-3">
          <span class="grid h-10 w-10 place-items-center rounded-xl bg-acento/15 text-acento" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4ZM7 6H4a3 3 0 0 0 3 4M17 6h3a3 3 0 0 1-3 4"></path>
            </svg>
          </span>
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-suave">Último logro</p>
        </div>
        <p class="mt-4 text-lg font-bold leading-snug">La constancia es tu superpoder.</p>
        <p class="mt-1 text-sm text-suave">10 entrenamientos. Cero excusas. Estás construyendo algo grande.</p>
        <a href="/progreso?tab=hitos" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primario hover:underline">
          Ver mis logros
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </aside>
  </div>
</Layout>
