---
import Layout from "../layouts/Layout.astro";

const ejercicios = [
  { nombre: "Press de banca", series: "4 × 8", peso: "80 kg" },
  { nombre: "Jalón al pecho", series: "3 × 12", peso: "65 kg" },
  { nombre: "Press inclinado", series: "3 × 10", peso: "28 kg" },
];
---

<Layout title="Inicio · AlFallo">
  <header class="mb-8">
    <p class="text-xs text-suave">Mi espacio / Resumen</p>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight md:text-4xl">Vamos a por más, Iker.</h1>
    <p class="mt-1 text-sm text-suave">Tu única competencia es quien eras ayer.</p>
  </header>

  <div class="grid gap-6 lg:grid-cols-[1fr_340px]">
    <!-- Comunidad -->
    <section aria-labelledby="comunidad">
      <div class="mb-3 flex items-center justify-between">
        <h2 id="comunidad" class="text-lg font-bold">Comunidad</h2>
        <span class="text-xs font-semibold text-primario">Siguiendo</span>
      </div>

      <article class="rounded-2xl border border-borde bg-superficie p-5">
        <div class="flex items-center gap-3">
          <div class="grid h-10 w-10 place-items-center rounded-full bg-elevada text-xs font-bold">AR</div>
          <div>
            <p class="text-sm font-semibold">Alex Rivera</p>
            <p class="text-xs text-suave">Hace 2 horas · Iron House Gym</p>
          </div>
        </div>

        <h3 class="mt-4 font-bold">Otro día. Otra marca personal.</h3>
        <p class="mt-1 text-sm text-suave">
          Entrenamiento de torso completado. Por fin, 80 kg en press de banca. Confía en el proceso.
        </p>

        <div class="mt-4 rounded-xl border border-borde bg-fondo p-4">
          <div class="flex items-center justify-between">
            <span class="text-sm font-semibold text-primario">Torso · Fuerza</span>
            <span class="text-[10px] font-bold uppercase tracking-wider text-acento">Completado</span>
          </div>

          <dl class="mt-3 grid grid-cols-3 gap-2">
            <div><dd class="text-xl font-bold">64 min</dd></div>
            <div><dd class="text-xl font-bold">6.240 kg</dd></div>
            <div><dd class="text-xl font-bold">18 series</dd></div>
          </dl>

          <table class="mt-4 w-full text-left text-sm">
            <thead class="text-[10px] uppercase tracking-wider text-suave">
              <tr>
                <th class="pb-2 font-medium">Ejercicio</th>
                <th class="pb-2 font-medium">Series × reps</th>
                <th class="pb-2 font-medium">Peso</th>
              </tr>
            </thead>
            <tbody>
              {
                ejercicios.map((e) => (
                  <tr class="border-t border-borde">
                    <td class="py-2">{e.nombre}</td>
                    <td class="py-2 text-suave">{e.series}</td>
                    <td class="py-2 font-semibold">{e.peso}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>

          <p class="mt-3 rounded-lg bg-acento/10 px-3 py-2 text-xs font-semibold text-acento">
            Nueva marca personal · Press de banca +5 kg
          </p>
        </div>

        <div class="mt-4 flex items-center gap-4 text-sm">
          <button type="button" class="rounded-lg bg-elevada px-3 py-2 font-semibold hover:bg-borde">
            Dar ánimos · 24
          </button>
          <span class="text-suave">6 comentarios</span>
        </div>
      </article>
    </section>

    <!-- Columna derecha -->
    <aside class="space-y-4">
      <h2 class="text-lg font-bold">Tu entrenamiento</h2>

      <div class="rounded-2xl border border-primario/30 bg-gradient-to-br from-primario/15 to-superficie p-5">
        <p class="text-[10px] font-bold uppercase tracking-widest text-primario">Próximo entrenamiento</p>
        <p class="mt-2 text-3xl font-extrabold">Torso</p>
        <p class="mt-1 text-sm text-suave">Gana fuerza. Supera tus límites.</p>
        <p class="mt-3 text-xs text-suave">6 ejercicios · 55–65 min</p>
        <a
          href="/rutinas"
          class="mt-4 block rounded-lg bg-primario py-3 text-center text-sm font-bold text-fondo transition hover:brightness-110"
        >
          Iniciar sesión
        </a>
      </div>

      <div class="rounded-2xl border border-borde bg-superficie p-5">
        <p class="text-[10px] font-bold uppercase tracking-widest text-suave">Último logro</p>
        <p class="mt-3 text-lg font-bold">La constancia es tu superpoder.</p>
        <p class="mt-1 text-sm text-suave">10 entrenamientos. Cero excusas. Estás construyendo algo grande.</p>
        <p class="mt-3 text-[10px] font-bold uppercase tracking-wider text-acento">Desbloqueado hoy</p>
      </div>
    </aside>
  </div>
</Layout>