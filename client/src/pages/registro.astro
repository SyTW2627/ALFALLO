---
import Layout from "../layouts/Layout.astro";
import AuthForm from "../components/AuthForm.jsx";
---

<Layout title="Crear cuenta · AlFallo" showNav={false} volver="/">
  <div class="relative grid min-h-[75vh] place-items-center">
    <div class="relative flex w-full justify-center">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -top-24 left-1/2 h-96 w-[44rem] max-w-[100vw] -translate-x-1/2 bg-[radial-gradient(closest-side,var(--brillo),transparent)]"
      ></div>
      <div class="relative flex w-full justify-center">
        <AuthForm client:load modo="registro" />
      </div>
    </div>
  </div>
</Layout>