---
import Layout from "../layouts/Layout.astro";
import AuthForm from "../components/AuthForm.jsx";
import BackLink from "../components/BackLink.astro";
---

<Layout title="Crear cuenta · AlFallo" showNav={false}>
  <BackLink href="/" />

  <div class="relative grid min-h-[75vh] place-items-center">
    <div class="relative flex w-full justify-center">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -top-20 left-1/2 h-72 w-[40rem] max-w-[100vw] -translate-x-1/2 bg-[radial-gradient(closest-side,rgb(242_106_27/0.14),transparent)]"
      ></div>
      <div class="relative flex w-full justify-center">
        <AuthForm client:load modo="registro" />
      </div>
    </div>
  </div>
</Layout>